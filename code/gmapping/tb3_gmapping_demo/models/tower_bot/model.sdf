<?xml version="1.0"?>
<sdf version="1.8">
  <model name="tower_bot">
    <pose>0 0 0 0 0 0</pose>

    <!-- =========================
         LINKS
         ========================= -->

    <!-- Base footprint (massless reference) -->
    <link name="base_footprint"/>

    <!-- Main base body -->
    <link name="base_link">
      <pose>0 0 0.06 0 0 0</pose>

      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.25</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.25</iyy> <iyz>0</iyz>
          <izz>0.35</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <!-- base cylinder -->
          <cylinder>
            <radius>0.18</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
              <slip1>0.02</slip1>
              <slip2>0.02</slip2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Mast -->
    <link name="mast_link">
      <pose>0 0 0.32 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.02</iyy> <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <collision name="mast_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.50</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="mast_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.50</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Top plate -->
    <link name="top_plate_link">
      <pose>0 0 0.58 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.01</iyy> <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>

      <collision name="top_plate_collision">
        <geometry>
          <cylinder>
            <radius>0.20</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="top_plate_visual">
        <geometry>
          <cylinder>
            <radius>0.20</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Left wheel -->
    <link name="wheel_left_link">
      <!-- moved outward + correct height -->
      <pose>0 0.24 0.05 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.002</iyy> <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="wheel_left_collision">
        <!-- ROTATE cylinder so its axis matches joint axis -->
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="wheel_left_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Right wheel -->
    <link name="wheel_right_link">
      <pose>0 -0.24 0.05 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.002</iyy> <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="wheel_right_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="wheel_right_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rear caster (simple sphere) -->
    <link name="caster_link">
      <pose>-0.12 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0002</iyy> <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry>
          <sphere><radius>0.02</radius></sphere>
        </geometry>
      </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere><radius>0.02</radius></sphere>
        </geometry>
      </visual>
    </link>

    <!-- IMU link -->
    <link name="imu_link">
      <pose>0 0 0.10 0 0 0</pose>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/imu</topic>
      </sensor>
    </link>

    <!-- LiDAR link (mounted on top plate) -->
    <link name="base_scan">
      <pose>0.10 0 0.12 0 0 0</pose>
      <visual name="lidar_body">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>

        <topic>/scan</topic>
        <gz_frame_id>base_scan</gz_frame_id>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.283185</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!-- Camera link (front of base) -->
    <link name="camera_link">
      <pose>0 0 0.10 0 0 0</pose>
      <visual name="camera_body">
        <geometry>
          <box>
            <size>0.05 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>

        <!-- Camera publishes /camera/image and /camera/camera_info in gz -->
        <topic>/camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>50</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- =========================
         JOINTS
         ========================= -->

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <joint name="mast_joint" type="fixed">
      <parent>base_link</parent>
      <child>mast_link</child>
    </joint>

    <joint name="top_plate_joint" type="fixed">
      <parent>mast_link</parent>
      <child>top_plate_link</child>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>top_plate_link</parent>
      <child>base_scan</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><effort>20</effort></limit>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><effort>20</effort></limit>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- =========================
         GAZEBO SIM SYSTEMS
         ========================= -->

    <!-- Differential drive (THIS MAKES IT MOVE) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- wheel geometry -->
      <wheel_separation>0.48</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <!-- topics (global so bridge is easy) -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>

      <tf_topic>/tf</tf_topic>
    </plugin>

    <!-- Joint states -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
    

  </model>
</sdf>